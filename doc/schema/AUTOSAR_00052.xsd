            <xsd:annotation>
               <xsd:documentation>Maximum allowed difference between two counter values of two consecutively received valid messages. For example, if the receiver gets data with counter 1 and MaxDeltaCounter is 3, then at the next reception the receiver can accept Counters with values 2, 3 or 4.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EndToEndTransformationComSpecProps.maxDeltaCounter";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
