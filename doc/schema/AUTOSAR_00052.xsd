            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="PERIOD" type="AR:MULTIDIMENSIONAL-TIME">
            <xsd:annotation>
               <xsd:documentation>The periodic distance between subsequent occurrences of the event.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="PeriodicEventTriggering.period";pureMM.maxOccurs="1";pureMM.minOccurs="0";xml.sequenceOffset="30"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
