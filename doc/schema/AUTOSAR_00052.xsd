               <xsd:appinfo source="tags">mmt.RestrictToStandards="CP";mmt.qualifiedName="BswModuleEntry.returnType";pureMM.maxOccurs="1";pureMM.minOccurs="0";vh.variationPointApplicable="false";xml.sequenceOffset="40"</xsd:appinfo>
