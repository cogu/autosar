            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="PARTS">
            <xsd:annotation>
               <xsd:documentation>This aggregation represents the collection of formula parts that can be combined by logical operators.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="DiagnosticEnvConditionFormula.part";pureMM.isOrdered="true";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
