               <xsd:documentation>Configured EID (Entity ID) used for VehicleIdentification Request.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.eid";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ENTITY-STATUS-MAX-BYTE-FIELD-USE" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>This attribute is used to distinguish the optional support of the Max data size element of a diagnostic entity status response.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.entityStatusMaxByteFieldUse";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="GID" type="AR:POSITIVE-UNLIMITED-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Configured GID (Group ID) used for VehicleIdentificationRequest. 
If configured, take this value (and set "Further action required" byte to 0x00="No further action required"), if not configured use ServiceInterface DoIPGroupIdentification to retrieve GID and 'further action required' values.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.gid";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
