               <xsd:appinfo source="tags">atp.Splitkey="feature";mmt.qualifiedName="FMFeatureModel.feature";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
               <xsd:appinfo source="stereotypes">atpSplitable</xsd:appinfo>
