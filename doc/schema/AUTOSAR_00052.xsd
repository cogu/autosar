               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="2";atp.Status="removed";mmt.qualifiedName="CalprmAxisCategoryEnum.curveAxis";xml.name="CURVE_AXIS"</xsd:appinfo>
