               <xsd:documentation>This indicates that there is no need to force a page break before this block.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";mmt.qualifiedName="ChapterEnumBreak.noBreak"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:complexType name="CLIENT-INTENT-ENUM">
      <xsd:annotation>
         <xsd:documentation>This meta-class represents the intent to specify how a given ServiceInterface is used from the perspective of a given client.</xsd:documentation>
         <xsd:appinfo source="tags">atp.Status="candidate";mmt.RestrictToStandards="AP";mmt.qualifiedName="ClientIntentEnum"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">enumeration</xsd:appinfo>
