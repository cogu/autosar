   <!-- element group for class AUTOSAR Templates::SystemTemplate::Fibex::Fibex4Ethernet::EthernetTopology::Ipv4ArpProps -->
   <xsd:group name="IPV-4-ARP-PROPS">
      <xsd:annotation>
         <xsd:documentation>Specifies the configuration options for the ARP (Address Resolution Protocol).</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="Ipv4ArpProps"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">atpObject</xsd:appinfo>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-ARP-NUM-GRATUITOUS-ARP-ON-STARTUP" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute specifies the number of gratuitous ARP replies which shall be sent on assignment of a new IP address.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv4ArpProps.tcpIpArpNumGratuitousArpOnStartup";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-ARP-PACKET-QUEUE-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>This attribute enables (TRUE) or disables (FALSE) support of the ARP Packet Queue according to IETF RFC 1122, section 2.3.2.2.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv4ArpProps.tcpIpArpPacketQueueEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-ARP-REQUEST-TIMEOUT" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute specifies a timeout in seconds for the validity of ARP requests. After the transmission of an ARP request the TcpIp shall skip the transmission of any further ARP requests to the same destination within a duration of tcpIpArpRequestTimeout seconds. (IETF RFC 1122, section 2.3.2.1).</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv4ArpProps.tcpIpArpRequestTimeout";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-ARP-TABLE-ENTRY-TIMEOUT" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute specifies the timeout in seconds after which an unused ARP entry is removed.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv4ArpProps.tcpIpArpTableEntryTimeout";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
