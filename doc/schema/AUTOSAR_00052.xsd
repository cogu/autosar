            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
   <!-- complex type for class AUTOSAR Templates::CommonStructure::Timing::TimingConstraint::LatencyTimingConstraint::LatencyTimingConstraint -->
