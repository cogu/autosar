               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="0";atp.Status="removed";mmt.qualifiedName="DiagnosticDataCaptureEnum.captureAsynchronouslyToReporting"</xsd:appinfo>
            </xsd:annotation>
