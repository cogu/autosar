            <xsd:annotation>
               <xsd:documentation>The existence of this reference indicates that the ServerComSpec refers to the getter of a Field.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="ServerComSpec.getter";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
