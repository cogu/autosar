   <xsd:complexType name="SECURITY-EVENT-REPORTING-MODE-ENUM">
      <xsd:annotation>
         <xsd:documentation>This enumeration controls the reporting mode of a security event.</xsd:documentation>
         <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="SecurityEventReportingModeEnum"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">enumeration</xsd:appinfo>
      </xsd:annotation>
      <xsd:simpleContent>
         <xsd:extension base="AR:SECURITY-EVENT-REPORTING-MODE-ENUM--SIMPLE">
            <xsd:attributeGroup ref="AR:AR-OBJECT"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>
   <xsd:simpleType name="SECURITY-EVENT-REPORTING-MODE-ENUM--SIMPLE">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="BRIEF">
            <xsd:annotation>
               <xsd:documentation>Only the main security event properties such as its ID are processed. Any additional context data (if existing) is discarded.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";atp.Status="candidate";mmt.qualifiedName="SecurityEventReportingModeEnum.brief"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="BRIEF-BYPASSING-FILTERS">
            <xsd:annotation>
               <xsd:documentation>The reported security event without its context data (if existing) is processed further but the filter chain is bypassed.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="3";atp.Status="candidate";mmt.qualifiedName="SecurityEventReportingModeEnum.briefBypassingFilters"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="DETAILED">
            <xsd:annotation>
               <xsd:documentation>The main properties and the context data (if existing) of the reported security event are processed further.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="2";atp.Status="candidate";mmt.qualifiedName="SecurityEventReportingModeEnum.detailed"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="DETAILED-BYPASSING-FILTERS">
            <xsd:annotation>
               <xsd:documentation>The reported security event including its context data (if existing) is processed further but the filter chain is bypassed.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="4";atp.Status="candidate";mmt.qualifiedName="SecurityEventReportingModeEnum.detailedBypassingFilters"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="OFF">
