               <xsd:appinfo source="tags">mmt.RestrictToStandards="CP";mmt.qualifiedName="CanTpConnection.cancellation";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
