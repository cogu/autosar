   <xsd:group name="EVENT-HANDLER">
      <xsd:annotation>
         <xsd:documentation>This element represents an event group as part of the Provided Service Instance.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="EventHandler"</xsd:appinfo>
