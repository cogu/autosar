               <xsd:documentation>This attribute defines the node ID when the PLCA mode for 10BASE-T1S is used.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="PlcaProps.plcaLocalNodeId";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="PLCA-MAX-BURST-COUNT" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Defines maximum packets allowed to be transmitted within a TO. This configuration can be different from one ECU to another within the PLCA mixed segment.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="PlcaProps.plcaMaxBurstCount";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
