               <xsd:documentation>This aggregation supports the configuration of the authentication of diagnostic clients.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Splitkey="externalAuthentication";mmt.RestrictToStandards="AP";mmt.qualifiedName="DiagnosticCommonProps.externalAuthentication";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
