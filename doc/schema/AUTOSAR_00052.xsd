         <xsd:element maxOccurs="1" minOccurs="0" name="SW-DATA-DEF-PROPS" type="AR:SW-DATA-DEF-PROPS">
            <xsd:annotation>
               <xsd:documentation>Via this aggregation it is possible to describe the properties of the data that is obtained from the application for the environmental condition.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Splitkey="swDataDefProps";mmt.qualifiedName="DiagnosticEnvDataElementCondition.swDataDefProps";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
               <xsd:appinfo source="stereotypes">atpSplitable</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
   <!-- complex type for class AUTOSAR Templates::DiagnosticExtract::Dcm::EnvironmentalCondition::DiagnosticEnvDataElementCondition -->
