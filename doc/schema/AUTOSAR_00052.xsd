   <!-- element group for class AUTOSAR Templates::SystemTemplate::SecureCommunication::IPSecRule -->
   <xsd:group name="IP-SEC-RULE">
      <xsd:annotation>
         <xsd:documentation>This element defines an IPsec rule that describes communication traffic that is monitored, protected and filtered.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">atpObject</xsd:appinfo>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="DIRECTION" type="AR:COMMUNICATION-DIRECTION-TYPE">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the direction in which the traffic is monitored. If this attribute is not set a bidirectional traffic monitoring is assumed.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.direction";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="HEADER-TYPE" type="AR:I-PSEC-HEADER-TYPE-ENUM">
            <xsd:annotation>
               <xsd:documentation>Header type specifying the IPsec security mechanism.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.headerType";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="IKE-AUTHENTICATION-METHOD" type="AR:IKE-AUTHENTICATION-METHOD-ENUM">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the IKE authentication method that is used locally and is expected on the remote side.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="removed";mmt.qualifiedName="IPSecRule.ikeAuthenticationMethod";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="IP-PROTOCOL" type="AR:I-PSEC-IP-PROTOCOL-ENUM">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the relevant IP protocol used in the Security Policy Database (SPD) entry.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.ipProtocol";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="LOCAL-CERTIFICATE-REFS">
            <xsd:annotation>
               <xsd:documentation>This reference identifies the applicable certificate used for a local authentication.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="CP,AP";mmt.qualifiedName="IPSecRule.localCertificate";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="LOCAL-CERTIFICATE-REF">
                     <xsd:complexType>
                        <xsd:simpleContent>
                           <xsd:extension base="AR:REF">
                              <xsd:attribute name="DEST" type="AR:CRYPTO-SERVICE-CERTIFICATE--SUBTYPES-ENUM" use="required"/>
                           </xsd:extension>
                        </xsd:simpleContent>
                     </xsd:complexType>
                  </xsd:element>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="LOCAL-ID" type="AR:STRING">
            <xsd:annotation>
               <xsd:documentation>This attribute defines how the local participant should be identified for authentication.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.localId";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="LOCAL-PORT-RANGE-END" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute restricts the traffic monitoring and defines an end value for the local port range.

If this attribute is not set then this rule shall be effective for all local ports.

Please note that port ranges are currently not supported in the AUTOSAR AP's operating system backend. If AP systems are involved, each IPsec rule may only contain a single port.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.localPortRangeEnd";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="LOCAL-PORT-RANGE-START" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute restricts the traffic monitoring and defines a start value for the local port range.

If this attribute is not set then this rule shall be effective for all local ports.

Please note that port ranges are currently not supported in the AUTOSAR AP's operating system backend. If AP systems are involved, each IPsec rule may only contain a single port.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.localPortRangeStart";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="MODE" type="AR:I-PSEC-MODE-ENUM">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the type of the connection.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.mode";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="POLICY" type="AR:I-PSEC-POLICY-ENUM">
            <xsd:annotation>
               <xsd:documentation>An IPsec policy defines the rules that determine which type of IP traffic needs to be secured using IPsec and how that traffic is secured.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.policy";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="PRE-SHARED-KEY-REF">
            <xsd:annotation>
               <xsd:documentation>This reference identifies the applicable cryptograhic key used for authentication.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.preSharedKey";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:simpleContent>
                  <xsd:extension base="AR:REF">
                     <xsd:attribute name="DEST" type="AR:CRYPTO-SERVICE-KEY--SUBTYPES-ENUM" use="required"/>
                  </xsd:extension>
               </xsd:simpleContent>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="PRIORITY" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the priority of the IPSecRule (SPD entry). The processing of entries is based on priority, starting with the highest priority "0".</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.priority";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="REMOTE-CERTIFICATE-REFS">
            <xsd:annotation>
               <xsd:documentation>This reference identifies the applicable certificate used for a remote authentication.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="CP,AP";mmt.qualifiedName="IPSecRule.remoteCertificate";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="REMOTE-CERTIFICATE-REF">
                     <xsd:complexType>
                        <xsd:simpleContent>
                           <xsd:extension base="AR:REF">
                              <xsd:attribute name="DEST" type="AR:CRYPTO-SERVICE-CERTIFICATE--SUBTYPES-ENUM" use="required"/>
                           </xsd:extension>
                        </xsd:simpleContent>
                     </xsd:complexType>
                  </xsd:element>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="REMOTE-ID" type="AR:STRING">
            <xsd:annotation>
               <xsd:documentation>This attribute defines how the remote participant should be identified for authentication.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.remoteId";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="REMOTE-IP-ADDRESS-REFS">
            <xsd:annotation>
               <xsd:documentation>Definition of the remote NetworkEndpoint. With 
this reference the connection between the local NetworkEndpoint and the remote NetworkEndpoint is described on which the traffic is monitored.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.remoteIpAddress";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="REMOTE-IP-ADDRESS-REF">
                     <xsd:complexType>
                        <xsd:simpleContent>
                           <xsd:extension base="AR:REF">
                              <xsd:attribute name="DEST" type="AR:NETWORK-ENDPOINT--SUBTYPES-ENUM" use="required"/>
                           </xsd:extension>
                        </xsd:simpleContent>
                     </xsd:complexType>
                  </xsd:element>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="REMOTE-PORT-RANGE-END" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute restricts the traffic monitoring and defines an end value for the remote port range.

If this attribute is not set then this rule shall be effective for all local ports.

Please note that port ranges are currently not supported in the AUTOSAR AP's operating system backend. If AP systems are involved, each IPsec rule may only contain a single port.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.remotePortRangeEnd";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="REMOTE-PORT-RANGE-START" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute restricts the traffic monitoring and defines a start value for the remote port range.

If this attribute is not set then this rule shall be effective for all local ports.

Please note that port ranges are currently not supported in the AUTOSAR AP's operating system backend. If AP systems are involved, each IPsec rule may only contain a single port.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecRule.remotePortRangeStart";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
