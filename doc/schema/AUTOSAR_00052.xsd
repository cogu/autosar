               <xsd:documentation>This literal indicates that a transformer chain shall be used to communicate the ISignal as UINT8_N over the bus.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="4";mmt.qualifiedName="DataTypePolicyEnum.transformingISignal"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
      </xsd:restriction>
