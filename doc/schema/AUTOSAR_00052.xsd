               <xsd:documentation>The response event representing the point in time where the event chain is terminated.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="TimingDescriptionEventChain.response";pureMM.maxOccurs="1";pureMM.minOccurs="0";xml.sequenceOffset="20"</xsd:appinfo>
