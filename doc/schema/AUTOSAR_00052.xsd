   <!-- element group for class AUTOSAR Templates::AdaptivePlatform::SoftwareDistribution::SoftwareClusterDependencyCompareCondition -->
   <xsd:group name="SOFTWARE-CLUSTER-DEPENDENCY-COMPARE-CONDITION">
      <xsd:annotation>
         <xsd:documentation>This meta-class represents the ability to specify a concrete dependency condition in the context of a SoftwareClusterDependencyFormula.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="SoftwareClusterDependencyCompareCondition"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">atpObject</xsd:appinfo>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="COMPARE-TYPE" type="AR:SOFTWARE-CLUSTER-DEPENDENCY-OPERATOR-ENUM">
            <xsd:annotation>
               <xsd:documentation>This attribute identifies the semantics of the compare operator.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="SoftwareClusterDependencyCompareCondition.compareType";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="CONSIDER-BUILD-NUMBER" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If this attribute is set to true then the build number shall be taken into account for the comparison. Build numbers don't have to be consecutive but could be created by some kind of hashing algorithm. In such a case it might make sense to include the build number in a test for equality but it is probably not reasonable to apply e.g. a less-than comparison.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="SoftwareClusterDependencyCompareCondition.considerBuildNumber";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="SOFTWARE-CLUSTER-REF">
