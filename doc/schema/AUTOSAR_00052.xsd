   <!-- element group for class AUTOSAR Templates::SystemTemplate::SecureCommunication::IPSecConfigProps -->
   <xsd:group name="IP-SEC-CONFIG-PROPS">
      <xsd:annotation>
         <xsd:documentation>This element holds all the attributes for configuration of IPsec that are independent of specific IPsec rules.</xsd:documentation>
         <xsd:appinfo source="tags">atp.recommendedPackage="IPSecConfigProps";mmt.qualifiedName="IPSecConfigProps"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">atpObject</xsd:appinfo>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="AH-CIPHER-SUITE-NAMES">
            <xsd:annotation>
               <xsd:documentation>AH (Authentication Header) algorithm to be used for the connection, e.g. HMAC/SHA2-256</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.ahCipherSuiteName";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="AH-CIPHER-SUITE-NAME" type="AR:STRING"/>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="DPD-ACTION" type="AR:I-PSEC-DPD-ACTION-ENUM">
            <xsd:annotation>
               <xsd:documentation>This attribute defines what to do if the peer is considered dead. 

If not configured "restart" shall be assumed.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.dpdAction";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="DPD-DELAY" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute describes the interval to check the liveness of a peer actively using IKEv2 INFORMATIONAL exchanges. Active DPD checking is only enforced if no IKE or ESP/AH packet has been received for the configured DPD delay.

In not configured the value "5 minutes" shall be assumed.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.dpdDelay";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ESP-CIPHER-SUITE-NAMES">
            <xsd:annotation>
               <xsd:documentation>ESP (Encapsulating Security Payload) algorithm that provides encryption and optional authentication for the connection, e.g. AES-128+SHA2-256.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.espCipherSuiteName";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="ESP-CIPHER-SUITE-NAME" type="AR:STRING"/>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="IKE-CIPHER-SUITE-NAME" type="AR:STRING">
            <xsd:annotation>
               <xsd:documentation>IKE encryption/authentication algorithms to be used for the connection.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.ikeCipherSuiteName";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="IKE-OVER-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute describes the hard deadline when an SA becomes invalid in percentage. 

Example: ikeOverTime of max(ikeReauthTime, ikeRekeyTime). 

Default: 10 %</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.ikeOverTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="IKE-RAND-TIME" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute defines in percentage by how long before the expiration of ikeReauthTime and ikeRekeyTime will be rekeyed/reauthenticated.

Default: 10%</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.ikeRandTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="IKE-REAUTH-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the absolute time after which an IKE SA will be reauthenticated.

0 means reauthentication is disabled.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.ikeReauthTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="IKE-REKEY-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the absolute time after which an IKE SA will be rekeyed.

0 means rekey is disabled.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.ikeRekeyTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="SA-OVER-TIME" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>This attribute describes the hard deadline when an IPsec SA becomes invalid in percentage. 

Example: saOverTime * saRekeyTime. 

Default: 110%</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.saOverTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="SA-RAND-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute defines by how long before the expiration of saRekeyTime will be rekeyed.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.saRandTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="SA-REKEY-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the absolute time after which an IPsec SA will be rekeyed.

0 means rekey is disabled.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="IPSecConfigProps.saRekeyTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
