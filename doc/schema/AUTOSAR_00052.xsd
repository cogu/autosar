   <!-- element group for class AUTOSAR Templates::SystemTemplate::Fibex::Fibex4Ethernet::EthernetTopology::EthernetWakeupSleepOnDatalineConfig -->
   <xsd:group name="ETHERNET-WAKEUP-SLEEP-ON-DATALINE-CONFIG">
      <xsd:annotation>
         <xsd:documentation>EthernetWakeupSleepOnDatalineConfigSet is the main element that aggregates different config set regarding the wakeup and sleep on data line.

An EthernetWakeupSleepOnDatalineConfigSet could aggregate multiple different configurations regarding the wakeup and sleep on dataline (EthernetWakeupSleepOnDatalineConfig).</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">atpObject</xsd:appinfo>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="SLEEP-MODE-EXECUTION-DELAY" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Delay in seconds to perform a sleep request if the Ethernet hardware (PHY) detect a pending wake-up. This is used to avoid the race condition, if a sleep was requested while a wake-up of a neighboring PHY was received via a local wake-up connection (e.g. I/O pin).</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.sleepModeExecutionDelay";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="SLEEP-REPETITION-DELAY-OF-SLEEP-REQUEST" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Delay in seconds for a repetition of a sleep request. This is used to retry a synchronized shutdown of the connected Ethernet hardware (PHY) of the link partner.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.sleepRepetitionDelayOfSleepRequest";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="SLEEP-REPETITIONS-OF-SLEEP-REQUEST" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Count of repetitions for a sleep on dataline. If a sleep is rejected by the linked communication partner, the sleep is repeated until the count of repetitions exceed. If count of repetitions exceed, the Ethernet hardware (PHY) transit to sleep without acknowledgement of the connected link partner.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.sleepRepetitionsOfSleepRequest";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-FORWARD-LOCAL-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled, then a remote wake-up received on the physical dataline (e.g. 100BASE-T1) is forwarded as local wake-up (e.g. via an I/O pin). If disabled, then a remote wake-up is not forwarded as local wake-up.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupForwardLocalEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-FORWARD-REMOTE-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled, then a local wake-up is forwarded to the physical dataline (e.g. 100BASE-T1). If disabled, then a local wake-up is not forwarded to the physical dataline.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupForwardRemoteEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-LOCAL-DETECTION-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Specify the detection time if a local wake-up in seconds is present on the local wake-up connection (e.g. I/O pin). A local wake-up has to be present at least for wakeupLocalDetectionTime to be detected a valid local wake-up.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupLocalDetectionTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-LOCAL-DURATION-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Specify the duration of a local wake-up in seconds to be present on the local wake-up connection (e.g. I/O pin).</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupLocalDurationTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-LOCAL-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled, then a local wake-up received via a local connection (e.g. I/O pin) shall be detected by the Ethernet hardware (PHY). If disabled, Ethernet hardware is not reacting on a local wake-up.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupLocalEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-REMOTE-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled, then a remote wake-up received via the physical dataline (e.g. 100BASE-T1) shall be detected by the Ethernet hardware (PHY). If disabled, Ethernet hardware is not reaction on a remote wake-up.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupRemoteEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-REPETITION-DELAY-OF-WAKEUP-REQUEST" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Delay in seconds for a repetition of a wake-up. This is used to increase the reliability in the network, such that an ECU which initiates the wake-up does repeat the wake-up and increase the probability that affected ECUs receive the wake-up.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupRepetitionDelayOfWakeupRequest";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="WAKEUP-REPETITIONS-OF-WAKEUP-REQUEST" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Count of repetitions for a wake-up. This is used to increase the reliability in the network, such that an ECU which initiates the wake-up does repeat the wake-up and increase the probability that affected ECUs receive the wake-up.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EthernetWakeupSleepOnDatalineConfig.wakeupRepetitionsOfWakeupRequest";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
