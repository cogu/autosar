   <!-- element group for class AUTOSAR Templates::SystemTemplate::Fibex::Fibex4Ethernet::EthernetTopology::Ipv6FragmentationProps -->
   <xsd:group name="IPV-6-FRAGMENTATION-PROPS">
      <xsd:annotation>
         <xsd:documentation>This meta-class specifies the configuration options for IPv6 packet fragmentation/reassembly.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6FragmentationProps"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">atpObject</xsd:appinfo>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-IP-REASSEMBLY-BUFFER-COUNT" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Number of buffers that can be used for fragment reassembly. In case of a reassembly error or if not all fragments are received in time this buffer will be blocked until the specified "Fragment Reassembly Timeout" has been exceeded. 

A value of 0 disables fragment reassembly.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6FragmentationProps.tcpIpIpReassemblyBufferCount";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-IP-REASSEMBLY-BUFFER-SIZE" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Size of each fragment tx buffer in bytes.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6FragmentationProps.tcpIpIpReassemblyBufferSize";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-IP-REASSEMBLY-SEGMENT-COUNT" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Specifies the maximum number of consecutive data segments that can be managed in each reassembly buffer. If all fragments are received in order, only one segment will be needed.

To deal with fragments received out of order this value should be configured bigger than 1.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6FragmentationProps.tcpIpIpReassemblySegmentCount";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-IP-REASSEMBLY-TIMEOUT" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Specifies the timeout in seconds after which an incomplete datagram gets discarded.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6FragmentationProps.tcpIpIpReassemblyTimeout";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-IP-TX-FRAGMENT-BUFFER-COUNT" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>These buffers will be used if the IpV6 receives packets from the upper layer that do not fit into the MTU and thus must be fragmented.

A value of 0 disables tx fragmentation.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6FragmentationProps.tcpIpIpTxFragmentBufferCount";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-IP-TX-FRAGMENT-BUFFER-SIZE" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Size of each fragment tx buffer in bytes.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6FragmentationProps.tcpIpIpTxFragmentBufferSize";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
