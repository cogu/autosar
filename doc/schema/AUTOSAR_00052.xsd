                     </xsd:complexType>
                  </xsd:element>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="EVENT-GROUP-IDENTIFIER" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Unique Identifier that identifies the EventGroup in SOME/IP. This Identifier is sent as Eventgroup ID in SOME/IP Service Discovery messages.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EventHandler.eventGroupIdentifier";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="EVENT-MULTICAST-ADDRESSS">
            <xsd:annotation>
               <xsd:documentation>Multicast Address that is used for event communication in the IP-Multicast case. It is the destination address to which the server sends the 
