   <xsd:complexType name="GLOBAL-TIME-ICV-VERIFICATION-ENUM">
      <xsd:annotation>
         <xsd:documentation>This enumeration is used to define how an Integrity Check Value (ICV) shall be handled at the receiver.</xsd:documentation>
         <xsd:appinfo source="tags">atp.Status="candidate";mmt.RestrictToStandards="CP";mmt.qualifiedName="GlobalTimeIcvVerificationEnum"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">enumeration</xsd:appinfo>
      </xsd:annotation>
      <xsd:simpleContent>
         <xsd:extension base="AR:GLOBAL-TIME-ICV-VERIFICATION-ENUM--SIMPLE">
            <xsd:attributeGroup ref="AR:AR-OBJECT"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>
   <xsd:simpleType name="GLOBAL-TIME-ICV-VERIFICATION-ENUM--SIMPLE">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="ICV-IGNORED">
            <xsd:annotation>
               <xsd:documentation>If the ICV is present, then it is ignored</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="2";mmt.RestrictToStandards="CP";mmt.qualifiedName="GlobalTimeIcvVerificationEnum.icvIgnored"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="ICV-NOT-VERIFIED">
            <xsd:annotation>
               <xsd:documentation>The ICV is not supposed to be present. If the ICV is present, then the message is ignored.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";mmt.RestrictToStandards="CP";mmt.qualifiedName="GlobalTimeIcvVerificationEnum.icvNotVerified"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="ICV-OPTIONAL">
            <xsd:annotation>
               <xsd:documentation>If the ICV is present, then it will be verified. If the ICV is not present, then this is also a valid reception (no verification required).</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="3";mmt.RestrictToStandards="CP";mmt.qualifiedName="GlobalTimeIcvVerificationEnum.icvOptional"</xsd:appinfo>
