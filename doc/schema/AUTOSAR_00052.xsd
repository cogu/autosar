               <xsd:documentation>Task is preemptable.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";mmt.RestrictToStandards="CP";mmt.qualifiedName="OsTaskPreemptabilityEnum.full"</xsd:appinfo>
            </xsd:annotation>
