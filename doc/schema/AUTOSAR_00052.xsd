            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ICMP-RULE" type="AR:ICMP-RULE">
            <xsd:annotation>
               <xsd:documentation>Configuration of filter rules for ICMP (Internet Control Message Protocol).</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.icmpRule";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
