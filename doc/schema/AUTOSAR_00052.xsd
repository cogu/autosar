               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.ttlMin";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
