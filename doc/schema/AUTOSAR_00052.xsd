   <!-- element group for class AUTOSAR Templates::SystemTemplate::Fibex::Fibex4Ethernet::EthernetTopology::Ipv6NdpProps -->
   <xsd:group name="IPV-6-NDP-PROPS">
      <xsd:annotation>
         <xsd:documentation>This meta-class specifies the configuration options for the Neighbor Discovery Protocol for IPv6.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">atpObject</xsd:appinfo>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DEFAULT-REACHABLE-TIME" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Configuration of the ReachableTime (s) specified in [RFC4861 6.3.2. Host Variables].</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDefaultReachableTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DEFAULT-RETRANS-TIMER" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Configures the default value (s) for the RetransTimer variable specified in [RFC4861 6.3.2. Host Variables].</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDefaultRetransTimer";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DEFAULT-ROUTER-LIST-SIZE" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Maximum number of default router entries.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDefaultRouterListSize";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DEFENSIVE-PROCESSING" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled the NDP shall only process Neighbor Advertisements which are received in reaction to a previously transmitted Neighbor Solicitation as well as skipping updates to the Neighbor Cache based on received Neighbor Solicitations. If disabled all Neighbor Advertisements and Solicitations shall be processed as specified in RFC4861.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDefensiveProcessing";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DELAY-FIRST-PROBE-TIME" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Delay before sending the first NUD probe in (s).</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="removed";mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDelayFirstProbeTime";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DELAY-FIRST-PROBE-TIME-VALUE" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Delay before sending the first NUD probe in (s).</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDelayFirstProbeTimeValue";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DESTINATION-CACHE-SIZE" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Maximum number of entries in the destination cache.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDestinationCacheSize";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DYNAMIC-HOP-LIMIT-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled the default hop limit may be reconfigured based on received Router Advertisements.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDynamicHopLimitEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DYNAMIC-MTU-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>Allow dynamic reconfiguration of link MTU via Router Advertisements.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDynamicMtuEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DYNAMIC-REACHABLE-TIME-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled the default Reachable Time value may be reconfigured based on received Router Advertisements.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDynamicReachableTimeEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-DYNAMIC-RETRANS-TIME-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled the default Retransmit Timer value may be reconfigured based on received Router Advertisements.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpDynamicRetransTimeEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-MAX-RANDOM-FACTOR" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Maximum random factor used for randomization</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpMaxRandomFactor";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-MAX-RTR-SOLICITATION-DELAY" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Maximum delay before the first Router Solicitation will be sent after interface initialization in (s).</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpMaxRtrSolicitationDelay";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-MAX-RTR-SOLICITATIONS" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Maximum number of Router Solicitations that will be sent before the first Router Advertisement has been received.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpMaxRtrSolicitations";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-MIN-RANDOM-FACTOR" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Minimum random factor used for randomization</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpMinRandomFactor";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-NEIGHBOR-UNREACHABILITY-DETECTION-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>Neighbor Unreachability Detection is used to remove unused entries from the neighbor cache. This feature is a basic feature of NDP and should be turned on.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpNeighborUnreachabilityDetectionEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-NUM-MULTICAST-SOLICITATIONS" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Maximum number of multicast solicitations that will be sent when performing address resolution.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpNumMulticastSolicitations";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-NUM-UNICAST-SOLICITATIONS" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Maximum number of unicast solicitations that will be sent when performig Neighbor Unreachability Detection.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpNumUnicastSolicitations";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-PACKET-QUEUE-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>Enables (TRUE) or disables (FALSE) support of a NDP Packet Queue according to IETF RFC 4861, section 7.2.2.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpPacketQueueEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-PREFIX-LIST-SIZE" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Maximum number of entries in the on-link prefix list.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpPrefixListSize";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-RANDOM-REACHABLE-TIME-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled the value of ReachableTime will be multiplied with a random value between MIN_RANDOM_FACTOR and MAX_RANDOM_FACTOR in order to prevent multiple nodes from transmitting at exactly the same time.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpRandomReachableTimeEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-RND-RTR-SOLICITATION-DELAY-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled the first router solicitation will be delayed randomly from [0...MAX_RTR_SOLICITATION_DELAY]. Otherwise the first router solicitation will be sent after exactly MAX_RTR_SOLICITATION_DELAY milliseconds.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpRndRtrSolicitationDelayEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-RTR-SOLICITATION-INTERVAL" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Interval between consecutive Router Solicitations in (s).</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpRtrSolicitationInterval";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-SLAAC-DAD-NUMBER-OF-TRANSMISSIONS" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Number of Neighbor Solicitations that have to be unanswered in order to set an autoconfigurated address to PREFERRED (usable) state.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpSlaacDadNumberOfTransmissions";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-SLAAC-DAD-RETRANSMISSION-DELAY" type="AR:TIME-VALUE">
            <xsd:annotation>
               <xsd:documentation>Sets the maximum value for the address configuration delay (s).</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpSlaacDadRetransmissionDelay";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-SLAAC-DELAY-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>If enabled transmission of the first DAD Neighbor Solicitation will be delayed by a random value from [0...MAX_DAD_DELAY].</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpSlaacDelayEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TCP-IP-NDP-SLAAC-OPTIMISTIC-DAD-ENABLED" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>Enable Optimistic Duplicate Address Detection (DAD) according to RFC4429.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6NdpProps.tcpIpNdpSlaacOptimisticDadEnabled";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
