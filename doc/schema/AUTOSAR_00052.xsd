               <xsd:documentation>The certificate is created in X.509 format.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";mmt.qualifiedName="CryptoCertificateFormatEnum.x509"</xsd:appinfo>
