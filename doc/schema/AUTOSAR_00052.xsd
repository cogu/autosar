            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="TIME">
            <xsd:annotation>
               <xsd:documentation>Time based operation cycle.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="4";mmt.qualifiedName="OperationCycleTypeEnum.time"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="WARMUP">
            <xsd:annotation>
               <xsd:documentation>OBD Warm up cycle.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="5";mmt.qualifiedName="OperationCycleTypeEnum.warmup"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:complexType name="ORIENT-ENUM">
      <xsd:annotation>
         <xsd:documentation>This enumerator specifies how the table shall be oriented.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="OrientEnum"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">enumeration</xsd:appinfo>
      </xsd:annotation>
      <xsd:simpleContent>
         <xsd:extension base="AR:ORIENT-ENUM--SIMPLE">
            <xsd:attributeGroup ref="AR:AR-OBJECT"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>
   <xsd:simpleType name="ORIENT-ENUM--SIMPLE">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="LAND">
            <xsd:annotation>
               <xsd:documentation>This indicates that the table is rendered in landscape which results in turning the table 90 degree clockwise.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="0";mmt.qualifiedName="OrientEnum.land"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="PORT">
            <xsd:annotation>
               <xsd:documentation>This indicates that the table is rendered in portrait, which is the regular text flow.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";mmt.qualifiedName="OrientEnum.port"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:complexType name="OS-ARTI-ADAPTER-LAUNCH-BEHAVIOR-ENUM">
      <xsd:annotation>
         <xsd:documentation>This enumeration provides options to start the OS/ARTI Adapter 
when starting the machine.</xsd:documentation>
         <xsd:appinfo source="tags">atp.Status="candidate";mmt.RestrictToStandards="AP";mmt.qualifiedName="OsArtiAdapterLaunchBehaviorEnum"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">enumeration</xsd:appinfo>
      </xsd:annotation>
      <xsd:simpleContent>
         <xsd:extension base="AR:OS-ARTI-ADAPTER-LAUNCH-BEHAVIOR-ENUM--SIMPLE">
            <xsd:attributeGroup ref="AR:AR-OBJECT"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>
   <xsd:simpleType name="OS-ARTI-ADAPTER-LAUNCH-BEHAVIOR-ENUM--SIMPLE">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="DO-NOT-INCLUDE">
            <xsd:annotation>
               <xsd:documentation>Do not include the OS/ARTI Adapter when building the system.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="0";atp.Status="candidate";mmt.RestrictToStandards="AP";mmt.qualifiedName="OsArtiAdapterLaunchBehaviorEnum.doNotInclude"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="INCLUDE-BUT-DO-NOT-START">
            <xsd:annotation>
               <xsd:documentation>Include the OS/ARTI Adapter when building the system but do 
not start it automatically.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="2";atp.Status="candidate";mmt.RestrictToStandards="AP";mmt.qualifiedName="OsArtiAdapterLaunchBehaviorEnum.includeButDoNotStart"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="START-ON-BOOT">
            <xsd:annotation>
               <xsd:documentation>Include the OS/ARTI Adapter when building the system and start 
it when booting the system.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";atp.Status="candidate";mmt.RestrictToStandards="AP";mmt.qualifiedName="OsArtiAdapterLaunchBehaviorEnum.startOnBoot"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:complexType name="OS-TASK-PREEMPTABILITY-ENUM">
      <xsd:annotation>
         <xsd:documentation>Enumeration that defines the possible preemptability values for OsTask.</xsd:documentation>
