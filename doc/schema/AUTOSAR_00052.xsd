               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="5";atp.Status="removed";mmt.qualifiedName="CalprmAxisCategoryEnum.fixAXIS_O";xml.name="FIX-AXIS"</xsd:appinfo>
            </xsd:annotation>
