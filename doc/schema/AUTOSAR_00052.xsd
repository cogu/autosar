               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="12";mmt.qualifiedName="GraphicFitEnum.Rotate90CwLimitToText"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
      </xsd:restriction>
