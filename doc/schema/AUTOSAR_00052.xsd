            <xsd:annotation>
               <xsd:documentation>This ISignal shall be taken to transport the responseError bit.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="CP";mmt.qualifiedName="LinErrorResponse.responseError";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:simpleContent>
