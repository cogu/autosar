               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="TAG-WITH-OPTIONAL-VALUE" type="AR:TAG-WITH-OPTIONAL-VALUE"/>
               </xsd:choice>
            </xsd:complexType>
