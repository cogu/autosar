               </xsd:simpleContent>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="PADDING-ACTIVATION" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>This specifies whether or not Sfs, FCs and the last CF shall be padded to 8 bytes length in case it contains less payload.

true:
The N-PDU received uses padding for SF, FC and the last CF. (N-PDU length is always 8 bytes)

false:
The N-PDU received does not use padding for SF, CF and the last CF. (N-PDU length is dynamic)</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="CP";mmt.qualifiedName="CanTpConnection.paddingActivation";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
