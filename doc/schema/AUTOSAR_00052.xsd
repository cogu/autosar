         <xsd:element maxOccurs="1" minOccurs="0" name="RTE-EVENT-IREFS">
            <xsd:annotation>
               <xsd:documentation>The RTE event used to receive the data via this buffer.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="McDataAccessDetails.rteEvent";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
