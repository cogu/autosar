            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="FIT-TO-TEXT">
            <xsd:annotation>
               <xsd:documentation>fit to the text containing the graphic.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="2";mmt.qualifiedName="GraphicFitEnum.FitToText"</xsd:appinfo>
