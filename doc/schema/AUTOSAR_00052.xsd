            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="MAPPING-SCOPE-PARTITION">
            <xsd:annotation>
               <xsd:documentation>The mapping constraint applies to different Partitions.</xsd:documentation>
