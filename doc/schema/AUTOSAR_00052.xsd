   <xsd:complexType abstract="false" mixed="false" name="IPV-6-PROPS">
      <xsd:annotation>
         <xsd:documentation>This meta-class specifies the configuration options for IPv6.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.qualifiedName="Ipv6Props"</xsd:appinfo>
