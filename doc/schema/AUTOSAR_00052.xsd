            <xsd:annotation>
               <xsd:documentation>Collection of SocketConnections in the connectionGroup.
This aggregation contains a variation point although it is not variant. Therefore, this variation point shall not exist in models. See constr_2638.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="obsolete";mmt.qualifiedName="SocketConnectionBundle.bundledConnection";pureMM.maxOccurs="-1";pureMM.minOccurs="0";vh.variationPointApplicable="false"</xsd:appinfo>
