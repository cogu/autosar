               <xsd:documentation>The source of the TP connection.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="FlexrayArTpConnection.source";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
