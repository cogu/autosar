            <xsd:annotation>
               <xsd:documentation>Collection of TpAddresses.

atpVariation: Derived, because EcuInstance can vary.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Splitkey="tpAddress.shortName, tpAddress.variationPoint.shortLabel";mmt.RestrictToStandards="CP";mmt.qualifiedName="LinTpConfig.tpAddress";pureMM.maxOccurs="-1";pureMM.minOccurs="0";vh.latestBindingTime="postBuild"</xsd:appinfo>
