   <xsd:group name="DO-IP-INSTANTIATION">
      <xsd:annotation>
         <xsd:documentation>This meta-class defines the attributes for the DoIP configuration on a specific machine.</xsd:documentation>
         <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation"</xsd:appinfo>
