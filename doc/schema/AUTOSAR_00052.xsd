            <xsd:annotation>
               <xsd:documentation>This indicates that CRC is not supported</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="0";mmt.qualifiedName="GlobalTimeCrcSupportEnum.crcNotSupported"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="CRC-SUPPORTED">
