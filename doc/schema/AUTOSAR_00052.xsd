                     <xsd:attribute name="DEST" type="AR:APPLICATION-ENDPOINT--SUBTYPES-ENUM" use="required"/>
                  </xsd:extension>
               </xsd:simpleContent>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="CONSUMED-EVENT-GROUP-REFS">
            <xsd:annotation>
               <xsd:documentation>All consumers of the event are referenced here.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="obsolete";mmt.qualifiedName="EventHandler.consumedEventGroup";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="CONSUMED-EVENT-GROUP-REF">
                     <xsd:complexType>
                        <xsd:simpleContent>
