               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="ProvidedSomeipServiceInstance.loadBalancingPriority";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
