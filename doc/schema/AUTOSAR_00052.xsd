      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="NEVER">
            <xsd:annotation>
               <xsd:documentation>The controlled port will never be set to enabled if the participants cannot establish and successfully use a MACsec Secure Channel.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="0";mmt.qualifiedName="MacSecFailPermissiveModeEnum.never"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="TIMEOUT">
            <xsd:annotation>
               <xsd:documentation>The controlled port will be set to enabled and MACsec will not be used in the port if the timeout value (onFailPermissiveModeTimeout) is reached and the following conditions apply: 

