         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ARGUMENTS">
            <xsd:annotation>
               <xsd:documentation>An argument belonging to this BswModuleEntry.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Splitkey="argument.shortName, argument.variationPoint.shortLabel";mmt.RestrictToStandards="CP";mmt.qualifiedName="BswModuleEntry.argument";pureMM.isOrdered="true";pureMM.maxOccurs="-1";pureMM.minOccurs="0";vh.latestBindingTime="blueprintDerivationTime";xml.sequenceOffset="45"</xsd:appinfo>
