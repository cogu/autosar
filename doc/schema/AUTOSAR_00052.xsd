                  <xsd:element name="RECORD-VALUE-SPECIFICATION" type="AR:RECORD-VALUE-SPECIFICATION"/>
                  <xsd:element name="REFERENCE-VALUE-SPECIFICATION" type="AR:REFERENCE-VALUE-SPECIFICATION"/>
                  <xsd:element name="TEXT-VALUE-SPECIFICATION" type="AR:TEXT-VALUE-SPECIFICATION"/>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="DATA-PROTOTYPE-IREF" type="AR:DATA-PROTOTYPE-IN-SYSTEM-INSTANCE-REF">
            <xsd:annotation>
               <xsd:documentation>This instanceRef represent the ability to access a data element owned by the application software on the AUTOSAR classic platform.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="DiagnosticEnvDataElementCondition.dataPrototype";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="P-PORT-PROTOTYPE-IREF" type="AR:P-PORT-PROTOTYPE-IN-EXECUTABLE-INSTANCE-REF">
            <xsd:annotation>
               <xsd:documentation>This instanceRef identifies the PortPrototype from which the relevant information for the environment condition can be obtained. This InstanceRef is only relevant for the adaptive platform.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DiagnosticEnvDataElementCondition.pPortPrototype";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
               <xsd:appinfo source="stereotypes">atpUriDef</xsd:appinfo>
            </xsd:annotation>
