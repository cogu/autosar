               <xsd:documentation>Defines whether a Ipv4 header checksum verification is performed or not.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.checksumVerification";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="DESTINATION-IP-ADDRESS" type="AR:IP4-ADDRESS-STRING">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets with the destination IPv4 address.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.destinationIpAddress";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="DESTINATION-NETWORK-MASK" type="AR:IP4-ADDRESS-STRING">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets with the destination IPv4 address range. 
The destinationIpAddress with the destinationNetworkMask defines the IP address range.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.destinationNetworkMask";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="DIFFERENTIATED-SERVICE-CODE-POINT" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets with a DSCP value.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.differentiatedServiceCodePoint";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="DO-NOT-FRAGMENT" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets that have the doNotFragment bit in the Header set.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.doNotFragment";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
