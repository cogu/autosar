   <xsd:complexType name="CRYPTO-KEY-SLOT-TYPE-ENUM">
      <xsd:annotation>
         <xsd:documentation>This enumeration defines the options for the usage of a Key Slot in the platform.</xsd:documentation>
         <xsd:appinfo source="tags">atp.Status="candidate";mmt.RestrictToStandards="AP,FO";mmt.qualifiedName="CryptoKeySlotTypeEnum"</xsd:appinfo>
         <xsd:appinfo source="stereotypes">enumeration</xsd:appinfo>
      </xsd:annotation>
      <xsd:simpleContent>
         <xsd:extension base="AR:CRYPTO-KEY-SLOT-TYPE-ENUM--SIMPLE">
            <xsd:attributeGroup ref="AR:AR-OBJECT"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>
   <xsd:simpleType name="CRYPTO-KEY-SLOT-TYPE-ENUM--SIMPLE">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="APPLICATION">
            <xsd:annotation>
               <xsd:documentation>KeySlot is used and modified exclusively by the Application.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="1";atp.Status="candidate";mmt.RestrictToStandards="AP,FO";mmt.qualifiedName="CryptoKeySlotTypeEnum.application"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
         <xsd:enumeration value="MACHINE">
            <xsd:annotation>
               <xsd:documentation>Key slot is used by platform modules only. The application manages the key but is not able to use the key.</xsd:documentation>
               <xsd:appinfo source="tags">atp.EnumerationLiteralIndex="0";atp.Status="candidate";mmt.RestrictToStandards="AP,FO";mmt.qualifiedName="CryptoKeySlotTypeEnum.machine"</xsd:appinfo>
            </xsd:annotation>
         </xsd:enumeration>
      </xsd:restriction>
