         <xsd:element maxOccurs="1" minOccurs="0" name="INTERNET-HEADER-LENGTH" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets with a minimum ipv4 header length.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.internetHeaderLength";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="MORE-FRAGMENTS" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets that have the moreFragments flag in the Header set.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.moreFragments";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="PROTOCOL" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets with a IP protocol number .</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.protocol";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="SOURCE-IP-ADDRESS" type="AR:IP4-ADDRESS-STRING">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets with the source IPv4 address.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.sourceIpAddress";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
