         <xsd:element maxOccurs="1" minOccurs="0" name="GID-INVALIDITY-PATTERN" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Specifies the Byte pattern that is used for response messages if no valid GID could be retrieved. 
Only the value '0' or '255' is allowed.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.gidInvalidityPattern";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="LOGICAL-ADDRESS" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Describes the logical address of the DoIP entity, which is used for VehicleAnnouncement and RoutingActivation responses.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.logicalAddress";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="MAX-REQUEST-BYTES" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Specifies the maximum allowed bytes of a DoIP message request without the DoIP header.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.maxRequestBytes";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="NETWORK-INTERFACES">
            <xsd:annotation>
               <xsd:documentation>Network interface specific DoIP properties.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.networkInterface";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="DO-IP-NETWORK-CONFIGURATION" type="AR:DO-IP-NETWORK-CONFIGURATION"/>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="REQUEST-CONFIGURATIONS">
            <xsd:annotation>
               <xsd:documentation>Request configuration that is used to determine whether an incoming DiagnosticMessage request needs to be interpreted as PHYSICAL or FUNCTIONAL. Any request with target address not within the configured target address range will be rejected.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.requestConfiguration";pureMM.maxOccurs="-1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
            <xsd:complexType>
               <xsd:choice maxOccurs="unbounded" minOccurs="0">
                  <xsd:element name="DO-IP-REQUEST-CONFIGURATION" type="AR:DO-IP-REQUEST-CONFIGURATION"/>
               </xsd:choice>
            </xsd:complexType>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="VIN-INVALIDITY-PATTERN" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Specifies the Byte pattern that is used for response messages if no valid VIN could be retrieved.
Only the value '0' or '255' is allowed.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.RestrictToStandards="AP";mmt.qualifiedName="DoIpInstantiation.vinInvalidityPattern";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
