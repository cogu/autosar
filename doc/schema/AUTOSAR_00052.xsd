               <xsd:appinfo source="tags">atp.Splitkey="signalMapping, signalMapping.variationPoint.shortLabel";mmt.qualifiedName="Gateway.signalMapping";pureMM.maxOccurs="-1";pureMM.minOccurs="0";vh.latestBindingTime="postBuild"</xsd:appinfo>
