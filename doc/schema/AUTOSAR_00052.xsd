               <xsd:documentation>Reference to additional settings for the E2E state machine.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EndToEndTransformationComSpecProps.e2eProfileCompatibilityProps";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
