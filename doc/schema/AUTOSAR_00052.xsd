               <xsd:documentation>Filter to match packets with the source IPv4 address range. 
The sourceIpAddress with the sourceNetworkMask defines the IP address range.</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.sourceNetworkMask";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TTL-MAX" type="AR:POSITIVE-INTEGER">
            <xsd:annotation>
               <xsd:documentation>Filter to match packets with a maximum ttl value (TimeToLive defines the lifetime of data on the network).</xsd:documentation>
               <xsd:appinfo source="tags">atp.Status="candidate";mmt.qualifiedName="Ipv4Rule.ttlMax";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="TTL-MIN" type="AR:POSITIVE-INTEGER">
