         <xsd:element maxOccurs="1" minOccurs="0" name="RX-SECURITY-VERIFICATION" type="AR:BOOLEAN">
            <xsd:annotation>
               <xsd:documentation>This attribute defines the bypassing of signature authentication or MAC verification in the receiving ECU.
