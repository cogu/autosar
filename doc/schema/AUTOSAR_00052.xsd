               <xsd:documentation>Clear monitoring window on transition from state Valid to state Invalid.</xsd:documentation>
               <xsd:appinfo source="tags">mmt.qualifiedName="EndToEndTransformationComSpecProps.clearFromValidToInvalid";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo>
            </xsd:annotation>
         </xsd:element>
